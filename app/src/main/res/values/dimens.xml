    <dimen name="video_ctrl_btn_gap">8dp</dimen>
    <dimen name="video_ctrl_icon_padding">6dp</dimen>
    <dimen name="video_ctrl_paddings_h">12dp</dimen>
    <dimen name="video_ctrl_padding_top">2dp</dimen>
    <dimen name="video_ctrl_padding_bottom">4dp</dimen>
    <dimen name="video_ctrl_text_size">13sp</dimen>
    <dimen name="video_play_center_size">60dp</dimen>
